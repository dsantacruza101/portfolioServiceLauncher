# NATS
# Generate a strong token: openssl rand -hex 32
NATS_TOKEN=
NATS_SERVERS=tls://nats-server:4222

# Client Gateway
CLIENT_GATEWAY_PORT=3000
TZ=America/Bogota
# "development" or "production"
CORS_ENV=development
# Comma-separated list of allowed origins (e.g. localhost,yourdomain.com)
CORS_ALLOW_DOMAINS=
# hCaptcha secret key — https://dashboard.hcaptcha.com
HCAPTCHA_SECRET=

# Email Microservice
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address that receives contact-form notifications
OWNER_EMAIL=
# "From" address shown on outgoing emails (must be verified with your provider)
MAIL_FROM=
